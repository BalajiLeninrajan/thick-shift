// The Node tools. They import packages/sim's TypeScript by relative path (Node strips the types), so tsc checks the
// parts of the sim they reach as part of this project. None of it needs browser globals.
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "${configDir}/node_modules/.tmp/tsconfig.tsbuildinfo",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["**/*.mjs", "**/*.js"]
}
