// The Node tools. They import packages/sim's TypeScript by relative path, and Node runs them as they are, by
// stripping the types. So they use only syntax stripping can erase, and their relative imports name the .ts file. tsc checks the parts of the sim they reach as part of this project.
// None of it needs browser globals.
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "${configDir}/node_modules/.tmp/tsconfig.tsbuildinfo",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
