// The Worker. Its globals come from the Workers runtime, not the browser. Each app's tsconfig.worker.json extends
// this, and ${configDir} is the directory of the config that does.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "${configDir}/node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["${configDir}/worker"]
}
