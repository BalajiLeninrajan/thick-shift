{
  "name": "thick-shift",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @thick-shift/web dev",
    "dev:discord": "pnpm --filter @thick-shift/discord dev",
    "build": "pnpm -r run build",
    "deploy": "pnpm --filter @thick-shift/web run deploy",
    "deploy:discord": "pnpm --filter @thick-shift/discord run deploy",
    "typecheck": "tsc -b",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
