{
  "name": "ThickShift",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": { "CameraMode": "LockFirstPerson" },
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "Players": {
      "$properties": { "CharacterAutoLoads": false }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0, 0, 0],
        "OutdoorAmbient": [0, 0, 0],
        "Brightness": 0,
        "ClockTime": 0,
        "GlobalShadows": true,
        "Technology": "Future"
      }
    },
    "SoundService": {
      "$properties": { "RespectFilteringEnabled": true }
    }
  }
}
