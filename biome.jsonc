{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Skip what git ignores: node_modules, dist, .wrangler.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      // Generated by the Blender scripts in tools/models.
      "!packages/game/public/models",
      "!tools/models/props_a/tex/atlas.json",
      "!pnpm-lock.yaml"
    ]
  },
  // Close to how the code was written. Most of what a narrower width changes is one-line blocks being split.
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "arrowParentheses": "asNeeded", "bracketSpacing": true, "trailingCommas": "es5" }
  },
  "json": { "formatter": { "trailingCommas": "none" } },
  // styles.css keeps one rule to a line on purpose. Formatting it would grow it five-fold, so it is linted but not
  // formatted.
  "css": { "formatter": { "enabled": false } },
  "html": { "formatter": { "enabled": false } },
  "markdown": { "formatter": { "enabled": false } },
  // Imports are sorted. A bare import (the stylesheet in each boot.ts) ends a run of imports, so nothing moves across
  // it. `pnpm lint` checks the order, and `pnpm lint --write` fixes it.
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // Clamps read as Math.min/Math.max.
        "useMathMinMax": "error"
      },
      "style": {
        // 26 in styles.css. Reordering rules to satisfy it changes which rule wins, so it would change how the page
        // looks. Revisit if the stylesheet is split up.
        "noDescendingSpecificity": "off",
        // Where the code knows a value is there, the types should say so: a PerMascot table read by a MascotIndex, a
        // Record keyed by DoorKey, a NonEmpty list, or a check from @thick-shift/sim/check or the game's dom.ts that
        // throws a named Error. A `!` that stays carries a biome-ignore comment giving the reason.
        "noNonNullAssertion": "error"
      },
      "suspicious": {
        // An assignment is a statement of its own, so a countdown or a cached value is not hidden inside a test.
        "noAssignInExpressions": "error"
      }
    }
  }
}
