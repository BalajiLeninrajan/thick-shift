{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Skip what git ignores: node_modules, dist, .wrangler.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      // Generated by the Blender scripts in tools/models.
      "!packages/game/public/models",
      "!tools/models/props_a/tex/atlas.json",
      // Luau and Rojo files, which Biome does not handle.
      "!apps/roblox",
      "!pnpm-lock.yaml"
    ]
  },
  // Set close to the code as it was written, so the first reformat stays small. Measured on the whole repo: lineWidth
  // 120, 140, 160 and 200 changed 13.5k, 12.9k, 12.5k and 12.2k lines; most of the change is one-line blocks being
  // split, which no setting avoids.
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "arrowParentheses": "asNeeded", "bracketSpacing": true, "trailingCommas": "es5" }
  },
  "json": { "formatter": { "trailingCommas": "none" } },
  // styles.css keeps one rule to a line on purpose. Formatting it would grow it five-fold (1,550 changed lines) for
  // no gain, so it is linted but not formatted.
  "css": { "formatter": { "enabled": false } },
  "html": { "formatter": { "enabled": false } },
  "markdown": { "formatter": { "enabled": false } },
  // Sorting imports would move side-effect imports (styles, audio) ahead of the modules that must load first. Off until
  // PR 5 of #7, when the client is ported to TS and its import order can be checked file by file.
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // Each rule below is off because obeying it would mean rewriting working code by hand. The counts are the
      // violations when the rule was turned off.
      "complexity": {
        // 3. `a && a.b` and `a?.b` differ when a is falsy but not null (0, '', false). Revisit in PR 6 of #7 (strict),
        // when the types say which values can be null.
        "useOptionalChain": "off",
        // 2, both clamp(). Math.min() orders 0 and -0 differently from the ternary. Revisit in PR 6 of #7.
        "useMathMinMax": "off"
      },
      "correctness": {
        // 18. Most keep a shared signature readable: strategy hooks that all take S, forEach indices. Revisit in
        // PR 6 of #7 (strict), alongside TypeScript's noUnusedParameters.
        "noUnusedFunctionParameters": "off"
      },
      "style": {
        // 26 in styles.css. Reordering rules to satisfy it changes which rule wins, so it would change how the page
        // looks. Revisit if the stylesheet is split up.
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        // 26. Assignments inside expressions (`return lensTex = new ...`, `if (!(b.woke ||= ...))`,
        // `(v.strain -= dt) <= 0`) are deliberate here. Revisit in PR 6 of #7 (strict).
        "noAssignInExpressions": "off",
        // 14. `list.forEach(x => f(x))` returns f's value to forEach, which ignores it; this one-line form is the
        // house style. Revisit in PR 5 of #7, when the client is ported to TS.
        "useIterableCallbackReturn": "off"
      }
    }
  }
}
