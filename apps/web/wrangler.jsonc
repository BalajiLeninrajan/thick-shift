{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thick-shift",
  "compatibility_date": "2026-11-15",
  // The Vite build's static files are served as-is. Requests that match no file
  // reach the Worker, which only answers /room/CODE (see worker/index.ts).
  "main": "./worker/index.ts",
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // The balajileninrajan.dev PostHog project's public token, for the rooms' events (packages/game/worker/posthog.ts).
  "vars": { "POSTHOG_KEY": "phc_zSX6drBG3mEQYboqHpWNu9L7AW3ZzRPhFGoS68asCHQz" }
}
