// Build config, run by Vite in Node.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "${configDir}/node_modules/.tmp/tsconfig.node.tsbuildinfo",
    // The sim's rules: type-only imports say `import type`, and nothing that stripping types cannot erase (enums,
    // parameter properties, namespaces).
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
